# Copy this file to vault.env, fill in real values, then encrypt it (see
# README.md). Never commit vault.env itself, only the encrypted vault.env.age.
#
# Section markers (### name) become the filename setup.sh writes each
# service's variables into: ~/.config/interview-platform/env/<name>.env
#
# Quote any value containing a space, e.g. NAME="Jane Doe", not NAME=Jane Doe.
# direnv's dotenv parser errors on unquoted spaces.

### core-api
NODE_ENV=development
PORT=4000
SECRET_KEY=
JWT_EXPIRES_IN_SECONDS=43200
LOG_LEVEL=info
CREDENTIALS=true
CORS_ORIGINS=http://localhost:3000
# Supabase's session pooler, port 5432 on the pooler host, not the direct
# connection (IPv6-only, unreachable from Docker) and not the transaction
# pooler on port 6543 (works for normal queries, but hangs on prisma db
# push / migrate, which need session-level features it doesn't support).
DATABASE_URL=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Full Name Here"
SUPER_ADMIN_COMPANY_NAME="Company Name Here"
# Resume PDFs are stored in S3. IAM user needs only s3:PutObject and
# s3:GetObject scoped to this bucket, nothing else.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

### web-frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

